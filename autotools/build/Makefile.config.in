
THOR_PACKAGE_NAME=@THOR_PACKAGE_NAME@


NO_UNUSED_PRIVATE_FIELD_TEST=@NO_UNUSED_PRIVATE_FIELD_TEST@
NO_DEPRECATED_REGISTER_TEST=@NO_DEPRECATED_REGISTER_TEST@
INCONSISTENT_MISSING_OVERRIDE=@INCONSISTENT_MISSING_OVERRIDE@
DELETE_NON_ABSTRACT_NON_VIRTUAL_DTOR=@DELETE_NON_ABSTRACT_NON_VIRTUAL_DTOR@
DELETE_NON_VIRTUAL_DTOR=@DELETE_NON_VIRTUAL_DTOR@
LITERAL_WARNING=@LITERAL_WARNING_SUFFIX@ @LITERAL_WARNING_RANGE@


CXX=@CXX@
COV=@COV@

DARK_MODE=@DARK_MODE@

CXXSTDVER=@CXXSTDVER@
CXX_STD_FLAG=@CXX_STD_FLAG@
THOR_TARGETLIBS=@THOR_TARGETLIBS@

VERATOOL=@VERATOOL@

prefix?=@prefix@
exec_prefix?=@exec_prefix@
bindir?=@bindir@
libdir?=@libdir@
includedir?=@includedir@
mandir?=@mandir@

DefaultLinkDir=@DefaultLinkDir@
# Not added to CXXFLAGS/LDFLAGS directly: core/variables.mk appends these
# after the local build/include and build/lib so locally built ThorsAnvil
# headers and libraries take precedence over installed (e.g. Homebrew) copies.
DEFAULT_LINK_INC = $(if $(DefaultLinkDir), -I $(DefaultLinkDir)/include)
DEFAULT_LINK_LIB = $(if $(DefaultLinkDir), -L $(DefaultLinkDir)/lib)

